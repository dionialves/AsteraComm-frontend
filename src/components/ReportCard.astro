---
interface Props {
  href: string;
  iconBg: string;
  title: string;
  description: string;
}
const { href, iconBg, title, description } = Astro.props;
---

<a href={href} class="block border border-[#e0e0e0] rounded-xl p-5 hover:border-[#c0c0c0] hover:shadow-sm transition-all cursor-pointer bg-white">
  <div class="w-8 h-8 rounded-lg flex items-center justify-center mb-3" style={`background:${iconBg}`}>
    <slot />
  </div>
  <p class="text-[14px] font-medium text-[#1a1a1a] mb-1">{title}</p>
  <p class="text-[12px] text-[#888] leading-relaxed">{description}</p>
</a>
