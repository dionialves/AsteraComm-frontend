---
import "../styles/global.css";
import config from "@/lib/config";

const { title = "AsteraComm - Softswitch" } = Astro.props;

// SSR: obter dados do usuário logado para visibilidade condicional do menu
const token = Astro.cookies.get("token")?.value;
let userData: Record<string, any> | null = null;
if (token) {
  try {
    const res = await fetch(`${config.api.baseUrl}/auth/me`, {
      headers: { Authorization: `Bearer ${token}`, Accept: "application/json" },
    });
    if (res.ok) userData = await res.json();
  } catch {}
}
const userRole     = userData?.role     ?? "";
const userName     = userData?.name     ?? "Usuário";
const userInitial  = userName.charAt(0).toUpperCase() || "?";
const showAdmin    = userRole === "SUPER_ADMIN" || userRole === "ADMIN";

function roleLabel(role: string) {
  if (role === "SUPER_ADMIN") return "Super Admin";
  if (role === "ADMIN")       return "Administrador";
  if (role === "USER")        return "Operador";
  return role;
}
---

<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>

<body class="font-sans">

  <!-- ── Sidebar ──────────────────────────────────────────────────────────── -->
  <aside id="sidebar" class="fixed top-0 left-0 w-[220px] h-screen bg-[#1a1a1a] flex flex-col z-[5] overflow-y-auto">

    <!-- Logo -->
    <div class="px-4 pt-5 pb-3 flex-shrink-0 text-center">
      <span class="text-[24px] font-medium tracking-[-0.5px]">
        <span class="text-[#5DCAA5]">Astera</span><span class="text-white">Comm</span>
      </span>
    </div>

    <!-- Navegação -->
    <nav class="flex-1 px-2 py-1 overflow-y-auto">

      <!-- Dashboard -->
      <a href="/" data-path="/"
        class="flex items-center gap-[10px] px-3 py-[9px] rounded-md text-[13px] text-white/65 no-underline mb-px cursor-pointer transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        Dashboard
      </a>

      <!-- OPERACIONAL -->
      <span class="text-[10px] font-semibold tracking-[1px] text-white/35 uppercase pt-[14px] px-3 pb-1 block">Operacional</span>

      <!-- Cadastro (colapsável) -->
      <button class="w-full flex items-center justify-between px-3 py-[9px] rounded-md border-none bg-transparent text-[13px] text-white/65 cursor-pointer mb-px transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90"
        data-target="menu-cadastro" data-paths="/circuits,/customers,/dids,/plans">
        <div class="flex items-center gap-[10px]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Cadastro
        </div>
        <svg class="flex-shrink-0 transition-transform duration-[250ms] ease" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <div id="menu-cadastro" class="max-h-0 overflow-hidden transition-[max-height] duration-[250ms] ease">
        <a href="/circuits"  data-path="/circuits"  class="block px-3 py-[7px] pl-[38px] text-[13px] text-white/55 no-underline rounded-md mb-px transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">Circuitos</a>
        <a href="/customers" data-path="/customers" class="block px-3 py-[7px] pl-[38px] text-[13px] text-white/55 no-underline rounded-md mb-px transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">Clientes</a>
        <a href="/dids"      data-path="/dids"      class="block px-3 py-[7px] pl-[38px] text-[13px] text-white/55 no-underline rounded-md mb-px transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">DIDs</a>
        <a href="/plans"     data-path="/plans"     class="block px-3 py-[7px] pl-[38px] text-[13px] text-white/55 no-underline rounded-md mb-px transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">Planos</a>
      </div>

      <!-- Configuração (colapsável) -->
      <button class="w-full flex items-center justify-between px-3 py-[9px] rounded-md border-none bg-transparent text-[13px] text-white/65 cursor-pointer mb-px transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90"
        data-target="menu-configuracao" data-paths="/trunks">
        <div class="flex items-center gap-[10px]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
            <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
            <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/>
            <line x1="17" y1="16" x2="23" y2="16"/>
          </svg>
          Configuração
        </div>
        <svg class="flex-shrink-0 transition-transform duration-[250ms] ease" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <div id="menu-configuracao" class="max-h-0 overflow-hidden transition-[max-height] duration-[250ms] ease">
        <a href="/trunks" data-path="/trunks" class="block px-3 py-[7px] pl-[38px] text-[13px] text-white/55 no-underline rounded-md mb-px transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">Troncos</a>
      </div>

      <!-- FINANCEIRO -->
      <span class="text-[10px] font-semibold tracking-[1px] text-white/35 uppercase pt-[14px] px-3 pb-1 block">Financeiro</span>

      <a href="/cdrs" data-path="/cdrs"
        class="flex items-center gap-[10px] px-3 py-[9px] rounded-md text-[13px] text-white/65 no-underline mb-px cursor-pointer transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.81a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Ligações
      </a>
      <a href="/reports" data-path="/reports"
        class="flex items-center gap-[10px] px-3 py-[9px] rounded-md text-[13px] text-white/65 no-underline mb-px cursor-pointer transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        Relatórios
      </a>

      <!-- ADMINISTRAÇÃO (condicional SSR) -->
      {showAdmin && (
        <>
          <span class="text-[10px] font-semibold tracking-[1px] text-white/35 uppercase pt-[14px] px-3 pb-1 block">Administração</span>
          <a href="/users" data-path="/users"
            class="flex items-center gap-[10px] px-3 py-[9px] rounded-md text-[13px] text-white/65 no-underline mb-px cursor-pointer transition-[background,color] duration-150 hover:bg-white/[0.05] hover:text-white/90">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
            Usuários
          </a>
        </>
      )}

    </nav>

    <!-- Rodapé: perfil -->
    <div class="flex-shrink-0 p-2 border-t border-white/[0.07] relative">

      <!-- Dropdown (abre para cima) -->
      <div id="profile-dropdown" class="hidden absolute bottom-[calc(100%+4px)] left-2 right-2 bg-[#2a2a2a] border border-white/10 rounded-lg overflow-hidden animate-[dropUp_0.15s_ease]">
        <button class="w-full text-left px-[14px] py-[9px] text-[13px] text-white/75 bg-transparent border-none cursor-pointer transition-[background,color] duration-[120ms] block hover:bg-white/[0.06] hover:text-white" id="btn-open-profile">Dados cadastrais</button>
        <button class="w-full text-left px-[14px] py-[9px] text-[13px] text-white/75 bg-transparent border-none cursor-pointer transition-[background,color] duration-[120ms] block hover:bg-white/[0.06] hover:text-white" id="btn-open-password">Alterar senha</button>
        <div class="border-t border-white/10"></div>
        <button class="w-full text-left px-[14px] py-[9px] text-[13px] text-[#f87171] bg-transparent border-none cursor-pointer transition-[background,color] duration-[120ms] block hover:bg-[rgba(239,68,68,0.12)]" id="btn-logout">Sair</button>
      </div>

      <!-- Botão do perfil -->
      <button id="profile-btn" class="w-full flex items-center gap-2 px-[10px] py-2 rounded-md bg-transparent border-none cursor-pointer transition-[background] duration-150 hover:bg-white/[0.05]">
        <div class="w-7 h-7 rounded-full bg-[#1D9E75] text-white text-[12px] font-semibold flex items-center justify-center flex-shrink-0">
          {userInitial}
        </div>
        <div class="flex-1 min-w-0 text-left">
          <p id="sidebar-user-name" class="text-[12px] text-white whitespace-nowrap overflow-hidden text-ellipsis">{userName}</p>
          <p class="text-[11px] text-white/40">{roleLabel(userRole)}</p>
        </div>
        <svg id="profile-chevron" class="flex-shrink-0 transition-transform duration-[250ms] ease" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
    </div>
  </aside>

  <!-- ── Conteúdo principal ───────────────────────────────────────────────── -->
  <main class="ml-[220px] min-h-screen overflow-y-auto p-8 bg-stone-50">
    <slot />
  </main>

  <!-- ── Overlay dos modais do layout ────────────────────────────────────── -->
  <div id="layout-overlay" class="modal-overlay !z-[200]"></div>

  <!-- ── Modal Dados Cadastrais (580px) ──────────────────────────────────── -->
  <div id="modal-profile" class="modal-main !w-[580px] !h-auto !z-[210]">
    <div class="modal-header">
      <div class="modal-header-top">
        <div class="modal-header-titles">
          <span class="modal-subtitle">Meu perfil</span>
          <span class="modal-title">Dados cadastrais</span>
        </div>
        <button class="modal-btn-close" data-close-modal="modal-profile">✕</button>
      </div>
    </div>
    <div id="profile-error" class="modal-error"></div>
    <div class="modal-body">
      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label">ID</label>
          <input id="p-id" type="text" class="form-input" disabled />
        </div>
        <div class="form-group">
          <label class="form-label">Username</label>
          <input id="p-username" type="text" class="form-input" disabled />
        </div>
      </div>
      <div class="form-group mb-3">
        <label class="form-label">Nome</label>
        <input id="p-name" type="text" class="form-input" placeholder="Nome completo" />
      </div>
      <div class="form-grid-2 mb-3">
        <div class="form-group">
          <label class="form-label">Role</label>
          <input id="p-role" type="text" class="form-input" disabled />
        </div>
        <div class="form-group">
          <label class="form-label">Ativo</label>
          <input id="p-active" type="text" class="form-input" disabled />
        </div>
      </div>
      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label">Criado em</label>
          <input id="p-created" type="text" class="form-input" disabled />
        </div>
        <div class="form-group">
          <label class="form-label">Atualizado em</label>
          <input id="p-updated" type="text" class="form-input" disabled />
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <div></div>
      <div class="modal-footer-right">
        <button class="btn-modal-cancel" data-close-modal="modal-profile">Cancelar</button>
        <button class="btn-modal-save" id="btn-save-profile">Salvar</button>
      </div>
    </div>
  </div>

  <!-- ── Modal Alterar Senha (420px) ─────────────────────────────────────── -->
  <div id="modal-password" class="modal-main !w-[420px] !h-auto !z-[210]">
    <div class="modal-header">
      <div class="modal-header-top">
        <div class="modal-header-titles">
          <span class="modal-subtitle">Meu perfil</span>
          <span class="modal-title">Alterar senha</span>
        </div>
        <button class="modal-btn-close" data-close-modal="modal-password">✕</button>
      </div>
    </div>
    <div id="pw-error" class="modal-error"></div>
    <div class="modal-body">
      <div class="form-group mb-3">
        <label class="form-label">Senha atual</label>
        <div class="input-password-wrap">
          <input id="pw-current" type="password" class="form-input" placeholder="Senha atual" autocomplete="current-password" />
          <button type="button" class="btn-eye" data-pw-toggle="pw-current">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="form-group mb-3">
        <label class="form-label">Nova senha</label>
        <div class="input-password-wrap">
          <input id="pw-new" type="password" class="form-input" placeholder="Nova senha" autocomplete="new-password" />
          <button type="button" class="btn-eye" data-pw-toggle="pw-new">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Confirmar nova senha</label>
        <div class="input-password-wrap">
          <input id="pw-confirm" type="password" class="form-input" placeholder="Confirmar nova senha" autocomplete="new-password" />
          <button type="button" class="btn-eye" data-pw-toggle="pw-confirm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <div></div>
      <div class="modal-footer-right">
        <button class="btn-modal-cancel" data-close-modal="modal-password">Cancelar</button>
        <button class="btn-modal-save disabled:opacity-50 disabled:cursor-default" id="btn-save-password" disabled>Salvar</button>
      </div>
    </div>
  </div>

  <!-- ── Toast ────────────────────────────────────────────────────────────── -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-[300] flex flex-col gap-2"></div>

  <script>
    // ── Active nav / auto-expand ─────────────────────────────────────────────
    const path = window.location.pathname.replace(/\/$/, "") || "/";

    // Direct nav items
    document.querySelectorAll("[data-path]").forEach(el => {
      const p = el.getAttribute("data-path");
      if (p && (path === p || (p !== "/" && path.startsWith(p) && p.length > 1))) {
        el.classList.add("!bg-white/[0.08]", "!text-white");
      }
    });

    // Collapsible menus: auto-expand if current path matches
    document.querySelectorAll("button[data-paths]").forEach(btn => {
      const paths = btn.getAttribute("data-paths")?.split(",") ?? [];
      const targetId = btn.getAttribute("data-target");
      const chevron = btn.querySelector("svg:last-child");
      const submenu = targetId ? document.getElementById(targetId) : null;
      if (!submenu) return;

      const isActive = paths.some(p => path === p || path.startsWith(p + "/"));
      if (isActive) {
        submenu.classList.remove("max-h-0");
        submenu.classList.add("max-h-[200px]");
        chevron?.classList.add("rotate-180");
        btn.classList.add("!bg-white/[0.08]", "!text-white");
      }

      btn.addEventListener("click", () => {
        const isOpen = submenu.classList.contains("max-h-[200px]");
        if (isOpen) {
          submenu.classList.remove("max-h-[200px]");
          submenu.classList.add("max-h-0");
          chevron?.classList.remove("rotate-180");
        } else {
          submenu.classList.remove("max-h-0");
          submenu.classList.add("max-h-[200px]");
          chevron?.classList.add("rotate-180");
        }
      });
    });

    // ── Profile dropdown ─────────────────────────────────────────────────────
    const profileBtn      = document.getElementById("profile-btn");
    const profileDropdown = document.getElementById("profile-dropdown");
    const profileChevron  = document.getElementById("profile-chevron");

    profileBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = profileDropdown?.classList.contains("hidden");
      profileDropdown?.classList.toggle("hidden", !isHidden);
      profileChevron?.classList.toggle("rotate-180", isHidden);
    });

    document.addEventListener("click", (e) => {
      if (!profileBtn?.contains(e.target as Node)) {
        profileDropdown?.classList.add("hidden");
        profileChevron?.classList.remove("rotate-180");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        profileDropdown?.classList.add("hidden");
        profileChevron?.classList.remove("rotate-180");
        closeAllModals();
      }
    });

    // ── Modal helpers ────────────────────────────────────────────────────────
    const overlay = document.getElementById("layout-overlay");

    function openModal(id: string) {
      document.getElementById(id)?.classList.add("open");
      overlay?.classList.add("active");
    }

    function closeModal(id: string) {
      document.getElementById(id)?.classList.remove("open");
      overlay?.classList.remove("active");
    }

    function closeAllModals() {
      ["modal-profile", "modal-password"].forEach(id => document.getElementById(id)?.classList.remove("open"));
      overlay?.classList.remove("active");
    }

    overlay?.addEventListener("click", closeAllModals);

    document.querySelectorAll("[data-close-modal]").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-close-modal");
        if (id) closeModal(id);
      });
    });

    // Password toggle visibility
    document.querySelectorAll("[data-pw-toggle]").forEach(btn => {
      btn.addEventListener("click", () => {
        const inputId = btn.getAttribute("data-pw-toggle");
        const input = inputId ? document.getElementById(inputId) as HTMLInputElement : null;
        if (input) input.type = input.type === "password" ? "text" : "password";
      });
    });

    // ── Carregar dados do usuário ────────────────────────────────────────────
    let userData: Record<string, any> | null = null;

    fetch("/api/auth/me")
      .then(r => r.ok ? r.json() : null)
      .then(data => { userData = data; });

    // ── Dados cadastrais ─────────────────────────────────────────────────────
    function roleLabel(role: string) {
      if (role === "SUPER_ADMIN") return "Super Admin";
      if (role === "ADMIN")       return "Administrador";
      if (role === "USER")        return "Operador";
      return role;
    }

    function fmtDate(s: string) {
      if (!s) return "—";
      return new Date(s).toLocaleString("pt-BR", {
        day: "2-digit", month: "2-digit", year: "numeric",
        hour: "2-digit", minute: "2-digit",
      });
    }

    document.getElementById("btn-open-profile")?.addEventListener("click", () => {
      if (!userData) return;
      profileDropdown?.classList.add("hidden");
      profileChevron?.classList.remove("rotate-180");
      const err = document.getElementById("profile-error");
      if (err) err.style.display = "none";

      (document.getElementById("p-id")      as HTMLInputElement).value = userData.id        ?? "";
      (document.getElementById("p-name")    as HTMLInputElement).value = userData.name      ?? "";
      (document.getElementById("p-username")as HTMLInputElement).value = userData.username  ?? "";
      (document.getElementById("p-role")    as HTMLInputElement).value = roleLabel(userData.role ?? "");
      (document.getElementById("p-active")  as HTMLInputElement).value = userData.enabled ? "Sim" : "Não";
      (document.getElementById("p-created") as HTMLInputElement).value = fmtDate(userData.createdAt);
      (document.getElementById("p-updated") as HTMLInputElement).value = fmtDate(userData.updatedAt);

      openModal("modal-profile");
    });

    document.getElementById("btn-save-profile")?.addEventListener("click", async () => {
      const name = (document.getElementById("p-name") as HTMLInputElement).value.trim();
      const err  = document.getElementById("profile-error");
      if (!name) {
        if (err) { err.textContent = "O nome não pode estar vazio."; err.style.display = "block"; }
        return;
      }
      try {
        const res = await fetch("/api/auth/me", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name }),
        });
        if (res.ok) {
          if (userData) userData.name = name;
          const el = document.getElementById("sidebar-user-name");
          if (el) el.textContent = name;
          closeModal("modal-profile");
          window.showToast?.("Dados atualizados com sucesso!", "success");
        } else {
          if (err) { err.textContent = "Erro ao atualizar dados."; err.style.display = "block"; }
        }
      } catch {
        if (err) { err.textContent = "Erro ao comunicar com o servidor."; err.style.display = "block"; }
      }
    });

    // ── Alterar senha ────────────────────────────────────────────────────────
    const pwCurrent = document.getElementById("pw-current") as HTMLInputElement;
    const pwNew     = document.getElementById("pw-new")     as HTMLInputElement;
    const pwConfirm = document.getElementById("pw-confirm") as HTMLInputElement;
    const pwSaveBtn = document.getElementById("btn-save-password") as HTMLButtonElement;

    function updatePwSaveBtn() {
      const ok = pwCurrent.value && pwNew.value && pwConfirm.value && pwNew.value === pwConfirm.value;
      pwSaveBtn.disabled = !ok;
    }

    [pwCurrent, pwNew, pwConfirm].forEach(el => el?.addEventListener("input", updatePwSaveBtn));

    document.getElementById("btn-open-password")?.addEventListener("click", () => {
      profileDropdown?.classList.add("hidden");
      profileChevron?.classList.remove("rotate-180");
      const err = document.getElementById("pw-error");
      if (err) err.style.display = "none";
      pwCurrent.value = ""; pwNew.value = ""; pwConfirm.value = "";
      updatePwSaveBtn();
      openModal("modal-password");
    });

    pwSaveBtn?.addEventListener("click", async () => {
      const err = document.getElementById("pw-error");
      if (pwNew.value !== pwConfirm.value) {
        if (err) { err.textContent = "As senhas não coincidem."; err.style.display = "block"; }
        return;
      }
      try {
        const res = await fetch("/api/auth/me/password", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ currentPassword: pwCurrent.value, newPassword: pwNew.value }),
        });
        if (res.ok) {
          closeModal("modal-password");
          window.showToast?.("Senha alterada com sucesso!", "success");
        } else if (res.status === 400) {
          if (err) { err.textContent = "Senha atual incorreta."; err.style.display = "block"; }
        } else {
          if (err) { err.textContent = "Erro ao alterar senha."; err.style.display = "block"; }
        }
      } catch {
        if (err) { err.textContent = "Erro ao comunicar com o servidor."; err.style.display = "block"; }
      }
    });

    // ── Logout ───────────────────────────────────────────────────────────────
    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "GET" });
      window.location.href = "/login";
    });
  </script>

  <script>
    window.showToast = function(message, type = "success") {
      const container = document.getElementById("toast-container");
      if (!container) return;
      const toast = document.createElement("div");
      toast.className = `flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg text-white text-sm transition-all duration-300 translate-x-full ${
        type === "success" ? "bg-[#1D9E75]" : "bg-red-600"
      }`;
      const text = document.createElement("span");
      text.textContent = message;
      const btn = document.createElement("button");
      btn.innerHTML = "&times;";
      btn.className = "text-white text-lg font-bold leading-none hover:opacity-70 ml-2";
      btn.addEventListener("click", () => removeToast(toast));
      toast.appendChild(text);
      toast.appendChild(btn);
      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove("translate-x-full");
        toast.classList.add("translate-x-0");
      });
      const timeout = setTimeout(() => removeToast(toast), 3000);
      (toast as any)._timeout = timeout;
      function removeToast(el: HTMLElement) {
        clearTimeout((el as any)._timeout);
        el.classList.remove("translate-x-0");
        el.classList.add("translate-x-full");
        setTimeout(() => el.remove(), 300);
      }
    };
  </script>

</body>
</html>
