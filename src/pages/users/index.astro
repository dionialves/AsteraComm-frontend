---
import Layout from "../../layouts/Layout.astro";
---

<style is:global>
  /* ── Linha da tabela ────────────────────────────────────────────────────── */
  .user-row {
    display: grid;
    grid-template-columns: 40px 68px minmax(0,1fr) minmax(0,1fr) 140px 140px;
    gap: 8px;
    padding: 14px 16px;
    align-items: center;
    cursor: pointer;
    background: #ffffff;
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.1s;
  }
  .user-row:last-child { border-bottom: none; }
  .user-row:hover { background: #fafafa; }
  .user-row.row-selected { background: #E6F1FB !important; border-left: 2px solid #378ADD; }
  .user-row.row-inactive { opacity: 0.55; }
  .user-row.row-inactive:hover { opacity: 0.75; }

  /* ── Tamanho do modal de usuário ────────────────────────────────────────── */
  .modal-user { height: auto; max-height: 85vh; }
</style>

<Layout title="AsteraComm - Usuários">
  <!-- ── Header ──────────────────────────────────────────────────────────── -->
  <div class="flex items-start justify-between mb-5">
    <div>
      <h1 class="text-[22px] font-medium text-[#1a1a1a]">Usuários</h1>
      <p class="text-[13px] text-[#888] mt-0.5">Controle de acesso e permissões do sistema</p>
    </div>
    <button id="btnAdd" class="flex items-center gap-1.5 bg-[#1D9E75] text-white text-[13px] font-medium px-3 py-[9px] rounded-md hover:opacity-90 transition-opacity">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Novo usuário
    </button>
  </div>

  <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
  <div class="flex items-center justify-between mb-3 gap-3 flex-wrap">
    <div class="flex items-center gap-3">
      <div class="relative w-[280px]">
        <svg class="absolute left-[10px] top-1/2 -translate-y-1/2 pointer-events-none text-[#aaa]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input id="input-search" type="text" placeholder="Buscar por nome ou username..."
          class="w-full pl-[34px] pr-3 py-[9px] text-[13px] border border-[#e0e0e0] rounded-md outline-none focus:border-[#378ADD] transition-colors bg-white text-[#1a1a1a] placeholder:text-[#aaa]" />
      </div>
      <div class="flex border border-[#e0e0e0] rounded-md overflow-hidden text-[13px]">
        <button data-filter="all"      class="filter-btn px-3 py-[7px] bg-white text-[#1a1a1a] font-medium border-r border-[#e0e0e0]">Todos</button>
        <button data-filter="active"   class="filter-btn px-3 py-[7px] text-[#888] border-r border-[#e0e0e0] hover:bg-[#fafafa]">Ativos</button>
        <button data-filter="inactive" class="filter-btn px-3 py-[7px] text-[#888] hover:bg-[#fafafa]">Inativos</button>
      </div>
    </div>
    <div id="pagination-controls" class="flex items-center gap-2">
      <button id="btn-prev" class="flex items-center justify-center w-7 h-7 rounded border border-[#e0e0e0] text-[#888] hover:bg-[#f5f5f5] transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span id="page-info" class="text-[12px] text-[#888] whitespace-nowrap">Página 1 de 1</span>
      <button id="btn-next" class="flex items-center justify-center w-7 h-7 rounded border border-[#e0e0e0] text-[#888] hover:bg-[#f5f5f5] transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

  <!-- ── Tabela ───────────────────────────────────────────────────────────── -->
  <div class="rounded-xl border border-[#e0e0e0] overflow-hidden">
    <div class="user-row bg-[#f5f5f5] border-b border-[#e0e0e0] cursor-default">
      <span data-field="id"        class="sort-col text-[11px] font-medium text-[#888] uppercase tracking-wide cursor-pointer select-none flex items-center gap-1">ID</span>
      <span data-field="enabled"   class="sort-col text-[11px] font-medium text-[#888] uppercase tracking-wide cursor-pointer select-none flex items-center gap-1">Status</span>
      <span data-field="name"      class="sort-col text-[11px] font-medium text-[#888] uppercase tracking-wide cursor-pointer select-none flex items-center gap-1">Nome</span>
      <span data-field="username"  class="sort-col text-[11px] font-medium text-[#888] uppercase tracking-wide cursor-pointer select-none flex items-center gap-1">Username</span>
      <span data-field="createdAt" class="sort-col text-[11px] font-medium text-[#888] uppercase tracking-wide cursor-pointer select-none flex items-center gap-1">Criado em</span>
      <span data-field="updatedAt" class="sort-col text-[11px] font-medium text-[#888] uppercase tracking-wide cursor-pointer select-none flex items-center gap-1">Atualizado em</span>
    </div>
    <div id="tbody-users"></div>
  </div>

  <p id="footer-count" class="text-[12px] text-[#888] text-right mt-3"></p>

  <!-- ── Overlay ──────────────────────────────────────────────────────────── -->
  <div id="modal-overlay" class="modal-overlay"></div>

  <!-- ── Modal ────────────────────────────────────────────────────────────── -->
  <div id="modal-main" class="modal-main modal-user">

    <!-- Header -->
    <div class="modal-header">
      <div class="modal-header-top">
        <div class="modal-header-titles">
          <span class="modal-subtitle">Usuário</span>
          <span id="modal-title" class="modal-title">—</span>
        </div>
        <button id="modal-btn-close" class="modal-btn-close" title="Fechar">✕</button>
      </div>
    </div>

    <!-- Error -->
    <div id="modal-error" class="modal-error"></div>

    <!-- Body: formulário -->
    <div id="form-body" class="modal-body pt-4">
      <div class="form-group mb-3">
        <label class="form-label">Nome</label>
        <input id="field-name" type="text" class="form-input" placeholder="Nome completo" />
      </div>
      <div class="form-group mb-3">
        <label class="form-label">Username</label>
        <input id="field-username" type="text" class="form-input" placeholder="Nome de usuário ou e-mail" />
      </div>
      <div id="password-group" class="form-group mb-3">
        <label class="form-label">Senha</label>
        <input id="field-password" type="password" class="form-input" placeholder="Senha" />
      </div>
      <!-- Toggle status (edit only) -->
      <div id="status-group" class="toggle-group !hidden">
        <label class="toggle-switch">
          <input id="field-active" type="checkbox" />
          <span class="toggle-slider"></span>
        </label>
        <span id="toggle-label" class="toggle-label">Ativo</span>
      </div>
    </div>

    <!-- Footer -->
    <div class="modal-footer">
      <button id="btn-delete" class="btn-modal-delete hidden">Excluir</button>
      <div class="modal-footer-right">
        <button id="btn-cancel" class="btn-modal-cancel">Cancelar</button>
        <button id="btn-save"   class="btn-modal-save">Salvar</button>
      </div>
    </div>

  </div>
</Layout>

<script type="module">
  const PAGE_SIZE  = 20;
  const ARROW_UP   = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>`;
  const ARROW_DOWN = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>`;

  // ── Estado ────────────────────────────────────────────────────────────────
  let allUsers      = [];
  let filteredUsers = [];
  let currentPage   = 0;
  let sortField     = "name";
  let sortDir       = "asc";
  let filterStatus  = "all";
  let searchTerm    = "";
  let selectedRow   = null;
  let editingId     = null;
  let deleteTimer   = null;

  // ── Elementos ─────────────────────────────────────────────────────────────
  const tbody       = document.getElementById("tbody-users");
  const pageInfo    = document.getElementById("page-info");
  const btnPrev     = document.getElementById("btn-prev");
  const btnNext     = document.getElementById("btn-next");
  const pagCtrl     = document.getElementById("pagination-controls");
  const footerCount = document.getElementById("footer-count");
  const searchInput = document.getElementById("input-search");

  const overlay         = document.getElementById("modal-overlay");
  const modalMain       = document.getElementById("modal-main");
  const modalTitle      = document.getElementById("modal-title");
  const modalError      = document.getElementById("modal-error");
  const formBody        = document.getElementById("form-body");
  const fieldName       = document.getElementById("field-name");
  const fieldUsername   = document.getElementById("field-username");
  const fieldPassword   = document.getElementById("field-password");
  const passwordGroup   = document.getElementById("password-group");
  const statusGroup     = document.getElementById("status-group");
  const fieldActive     = document.getElementById("field-active");
  const toggleLabel     = document.getElementById("toggle-label");
  const btnDelete       = document.getElementById("btn-delete");
  const btnCancel       = document.getElementById("btn-cancel");
  const btnSave         = document.getElementById("btn-save");

  // ── Busca (debounce 300ms) ────────────────────────────────────────────────
  let debounceTimer;
  searchInput.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      searchTerm  = searchInput.value.trim().toLowerCase();
      currentPage = 0;
      applyAndRender();
    }, 300);
  });

  // ── Filtros de status ─────────────────────────────────────────────────────
  document.querySelectorAll(".filter-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach(b => {
        b.classList.remove("bg-white", "text-[#1a1a1a]", "font-medium");
        b.classList.add("text-[#888]");
      });
      btn.classList.remove("text-[#888]");
      btn.classList.add("bg-white", "text-[#1a1a1a]", "font-medium");
      filterStatus = btn.dataset.filter;
      currentPage  = 0;
      applyAndRender();
    });
  });

  // ── Sort ──────────────────────────────────────────────────────────────────
  document.querySelectorAll(".sort-col").forEach(col => {
    col.addEventListener("click", () => {
      const field = col.dataset.field;
      if (sortField === field) {
        sortDir = sortDir === "asc" ? "desc" : "asc";
      } else {
        sortField = field;
        sortDir   = "asc";
      }
      updateSortArrows();
      currentPage = 0;
      applyAndRender();
    });
  });

  function updateSortArrows() {
    document.querySelectorAll(".sort-col").forEach(col => {
      const existing = col.querySelector(".sort-arrow");
      if (existing) existing.remove();
      if (col.dataset.field === sortField) {
        const span = document.createElement("span");
        span.className = "sort-arrow";
        span.innerHTML = sortDir === "asc" ? ARROW_UP : ARROW_DOWN;
        col.appendChild(span);
      }
    });
  }

  // ── Paginação ─────────────────────────────────────────────────────────────
  btnPrev.addEventListener("click", () => { if (currentPage > 0) { currentPage--; renderPage(); } });
  btnNext.addEventListener("click", () => {
    const total = Math.ceil(filteredUsers.length / PAGE_SIZE) || 1;
    if (currentPage < total - 1) { currentPage++; renderPage(); }
  });

  // ── Fetch ─────────────────────────────────────────────────────────────────
  async function fetchUsers() {
    try {
      const res = await fetch("/api/users/users?page=0&size=200&sort=name,asc");
      if (!res.ok) throw new Error();
      const data = await res.json();
      allUsers = data.content ?? [];
      applyAndRender();
    } catch {
      tbody.innerHTML = `<div class="px-4 py-6 text-[13px] text-[#888] text-center">Erro ao carregar usuários.</div>`;
    }
  }

  // ── Filtro + Sort + Render ────────────────────────────────────────────────
  function sortValue(u, field) {
    switch (field) {
      case "id":        return u.id ?? 0;
      case "enabled":   return u.enabled ? 0 : 1;
      case "name":      return (u.name ?? "").toLowerCase();
      case "username":  return (u.username ?? "").toLowerCase();
      case "createdAt": return u.createdAt ?? "";
      case "updatedAt": return u.updatedAt ?? "";
      default:          return "";
    }
  }

  function applyAndRender() {
    filteredUsers = allUsers.filter(u => {
      const matchSearch =
        !searchTerm ||
        (u.name?.toLowerCase().includes(searchTerm)) ||
        (u.username?.toLowerCase().includes(searchTerm));
      const matchStatus =
        filterStatus === "all" ||
        (filterStatus === "active"   &&  u.enabled) ||
        (filterStatus === "inactive" && !u.enabled);
      return matchSearch && matchStatus;
    });

    filteredUsers.sort((a, b) => {
      const va = sortValue(a, sortField);
      const vb = sortValue(b, sortField);
      if (va < vb) return sortDir === "asc" ? -1 :  1;
      if (va > vb) return sortDir === "asc" ?  1 : -1;
      return 0;
    });

    renderPage();
  }

  function renderPage() {
    const totalPages = Math.ceil(filteredUsers.length / PAGE_SIZE) || 1;
    if (currentPage >= totalPages) currentPage = totalPages - 1;
    const slice = filteredUsers.slice(currentPage * PAGE_SIZE, (currentPage + 1) * PAGE_SIZE);

    pagCtrl.style.display = filteredUsers.length > PAGE_SIZE ? "" : "none";
    pageInfo.textContent  = `Página ${currentPage + 1} de ${totalPages}`;
    btnPrev.disabled      = currentPage === 0;
    btnNext.disabled      = currentPage >= totalPages - 1;

    const total = filteredUsers.length;
    footerCount.textContent = total === 1 ? "1 usuário cadastrado" : `${total} usuários cadastrados`;

    tbody.innerHTML = "";

    if (slice.length === 0) {
      tbody.innerHTML = `<div class="px-4 py-6 text-[13px] text-[#888] text-center">Nenhum usuário encontrado.</div>`;
      return;
    }

    slice.forEach(item => {
      const row = document.createElement("div");
      row.className = "user-row" + (!item.enabled ? " row-inactive" : "");
      row.dataset.uid = item.id;

      const dotColor  = item.enabled ? "#1D9E75" : "#E24B4A";
      const txtColor  = item.enabled ? "#085041"  : "#791F1F";
      const statusTxt = item.enabled ? "Ativo"    : "Inativo";

      row.innerHTML = `
        <span class="text-[13px] text-[#888] font-mono">${item.id}</span>
        <span class="flex items-center gap-[6px]">
          <span style="width:7px;height:7px;border-radius:50%;background:${dotColor};flex-shrink:0"></span>
          <span class="text-[13px]" style="color:${txtColor}">${statusTxt}</span>
        </span>
        <span class="text-[13px] font-medium text-[#1a1a1a] truncate">${item.name ?? "—"}</span>
        <span class="text-[12px] text-[#888] truncate">${item.username}</span>
        <span class="text-[12px] text-[#888]">${formatDate(item.createdAt)}</span>
        <span class="text-[12px] text-[#888]">${formatDate(item.updatedAt)}</span>
      `;

      row.addEventListener("click", () => openModal(item.id));
      tbody.appendChild(row);
    });
  }

  // ── Helpers ───────────────────────────────────────────────────────────────
  function formatDate(str) {
    if (!str) return "—";
    return new Date(str).toLocaleDateString("pt-BR", { day:"2-digit", month:"2-digit", year:"numeric", hour:"2-digit", minute:"2-digit" });
  }

  function showError(msg) {
    modalError.textContent = msg;
    modalError.style.display = "block";
  }

  function clearError() {
    modalError.style.display = "none";
    modalError.textContent   = "";
  }

  // ── Modal: abrir / fechar ─────────────────────────────────────────────────
  function resetDeleteBtn() {
    clearTimeout(deleteTimer);
    deleteTimer = null;
    btnDelete.textContent = "Excluir";
    btnDelete.classList.remove("confirm");
  }

  function openModal(userId) {
    editingId = userId || null;
    resetDeleteBtn();
    const isEdit = !!editingId;

    // Reset campos
    fieldName.value     = "";
    fieldUsername.value = "";
    fieldPassword.value = "";
    fieldActive.checked = true;
    toggleLabel.textContent = "Ativo";
    clearError();

    modalTitle.textContent      = isEdit ? "Editar Usuário" : "Novo Usuário";
    passwordGroup.classList.toggle("!hidden", isEdit);
    statusGroup.classList.toggle("!hidden", !isEdit);
    btnDelete.classList.toggle("hidden", !isEdit);

    if (isEdit) {
      fieldUsername.disabled = true;
      fieldUsername.classList.add("form-input");

      fetch(`/api/users/${userId}`)
        .then(r => { if (!r.ok) throw new Error(); return r.json(); })
        .then(data => {
          fieldName.value         = data.name     ?? "";
          fieldUsername.value     = data.username ?? "";
          fieldActive.checked     = data.enabled  ?? true;
          toggleLabel.textContent = data.enabled ? "Ativo" : "Inativo";
        })
        .catch(() => showError("Erro ao carregar dados do usuário."));
    } else {
      fieldUsername.disabled = false;
    }

    // Seleciona linha
    if (selectedRow) selectedRow.classList.remove("row-selected");
    selectedRow = tbody.querySelector(`[data-uid="${userId}"]`);
    if (selectedRow) selectedRow.classList.add("row-selected");

    overlay.classList.add("active");
    modalMain.classList.add("open");
  }

  function closeModal() {
    overlay.classList.remove("active");
    modalMain.classList.remove("open");
    if (selectedRow) selectedRow.classList.remove("row-selected");
    selectedRow = null;
    editingId   = null;
    resetDeleteBtn();
  }

  // ── Toggle ativo/inativo ──────────────────────────────────────────────────
  fieldActive.addEventListener("change", () => {
    toggleLabel.textContent = fieldActive.checked ? "Ativo" : "Inativo";
  });

  // ── Eventos de botões ─────────────────────────────────────────────────────
  document.getElementById("btnAdd").addEventListener("click", () => openModal(null));
  document.getElementById("modal-btn-close").addEventListener("click", closeModal);
  overlay.addEventListener("click", closeModal);
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && modalMain.classList.contains("open")) closeModal();
  });

  btnCancel.addEventListener("click", closeModal);

  btnDelete.addEventListener("click", async () => {
    if (btnDelete.classList.contains("confirm")) {
      // segundo clique — executar exclusão
      resetDeleteBtn();
      try {
        const res = await fetch(`/api/users/${editingId}`, { method: "DELETE" });
        if (res.ok || res.status === 204) {
          closeModal();
          fetchUsers();
          window.showToast("Usuário excluído com sucesso!", "success");
        } else {
          showError("Erro ao excluir usuário.");
        }
      } catch {
        showError("Erro ao comunicar com o servidor.");
      }
    } else {
      // primeiro clique — pedir confirmação
      btnDelete.textContent = "Confirmar exclusão";
      btnDelete.classList.add("confirm");
      deleteTimer = setTimeout(resetDeleteBtn, 3000);
    }
  });

  btnSave.addEventListener("click", async () => {
    const name     = fieldName.value.trim();
    const username = fieldUsername.value.trim();
    const password = fieldPassword.value;
    const enabled  = fieldActive.checked;
    const isEdit   = !!editingId;

    if (!name)                { showError("O nome é obrigatório.");                       return; }
    if (!username)            { showError("O username é obrigatório.");                   return; }
    if (!isEdit && !password) { showError("A senha é obrigatória para novos usuários."); return; }

    clearError();

    try {
      let res;
      if (isEdit) {
        res = await fetch(`/api/users/${editingId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, enabled }),
        });
      } else {
        res = await fetch("/api/users/users", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, username, password }),
        });
      }

      if (res.ok) {
        closeModal();
        fetchUsers();
        window.showToast(isEdit ? "Usuário atualizado com sucesso!" : "Usuário criado com sucesso!", "success");
      } else {
        const txt = await res.text();
        showError(txt || "Erro ao salvar usuário.");
      }
    } catch {
      showError("Erro ao comunicar com o servidor.");
    }
  });

  // ── Init ──────────────────────────────────────────────────────────────────
  updateSortArrows();
  fetchUsers();
</script>
